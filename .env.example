# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# App-Typ: Web API. Redirect URI exakt eintragen.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# connect = Web API steuert die Spotify-App (privat, Dev Mode)
# deeplink = öffnet Spotify über Link (veröffentlichbar)
NEXT_PUBLIC_PLAYBACK_MODE=connect

# Öffentliche Basis-URL der App (QR-Codes, OAuth in Produktion)
NEXT_PUBLIC_APP_URL=http://localhost:3000
